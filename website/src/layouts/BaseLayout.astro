---
import ProductLayout from '@/features/product/ProductLayout.astro';
import '@/features/legal/legal.css';
interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
}
const props = Astro.props;
---

<ProductLayout
  {...props}
  locale="en"
  section=""
  legal
  showAlternates={false}
  bodyClass={`legal-site ${props.bodyClass ?? ''}`}
>
  <slot />
</ProductLayout>
