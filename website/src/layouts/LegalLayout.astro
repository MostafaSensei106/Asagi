---
import { render } from 'astro:content';
import { ChevronRight, FileText, Printer, Scale } from '@lucide/astro';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import DocumentMeta from '@/features/legal/DocumentMeta.astro';
import TableOfContents from '@/features/legal/TableOfContents.astro';
import ContactCard from '@/features/support/ContactCard.astro';
import type { LegalDocument } from '@/lib/legal';
import { withBase } from '@/lib/paths';

interface Props {
  document: LegalDocument;
  siblings: LegalDocument[];
  appName: string;
  appDescription: string;
}

const { document: doc, siblings, appName, appDescription } = Astro.props;
const { Content, headings } = await render(doc.entry);

const { data } = doc.entry;
const path = `/${doc.appId}/${doc.documentId}`;
const title = `${appName} ${doc.label}`;
const otherDocuments = siblings.filter((sibling) => sibling.id !== doc.id);

const jsonLd = [
  {
    '@type': 'DigitalDocument',
    name: title,
    description: data.description,
    url: path,
    dateModified: data.updatedDate.toISOString(),
    datePublished: data.effectiveDate.toISOString(),
    inLanguage: 'en',
    publisher: { '@type': 'Organization', name: appName },
  },
];
---

<BaseLayout
  title={title}
  description={data.description}
  path={path}
  type="article"
  noindex={data.draft}
  publishedTime={data.effectiveDate}
  modifiedTime={data.updatedDate}
  jsonLd={jsonLd}
>
  <div class="page-shell py-10 sm:py-14">
    <nav aria-label="Breadcrumb" class="no-print mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
        <li>
          <a href={withBase('/')} class="transition-colors hover:text-fg">
            All apps
          </a>
        </li>
        <li aria-hidden="true">
          <ChevronRight class="size-4 text-border-strong" stroke-width={2} />
        </li>
        <li>
          <a href={withBase(`/${doc.appId}`)} class="transition-colors hover:text-fg">
            {appName}
          </a>
        </li>
        <li aria-hidden="true">
          <ChevronRight class="size-4 text-border-strong" stroke-width={2} />
        </li>
        <li aria-current="page" class="font-medium text-fg">
          {doc.label}
        </li>
      </ol>
    </nav>

    <div class="grid gap-12 xl:grid-cols-[minmax(0,1fr)_17rem] xl:gap-16">
      <article
        aria-labelledby="document-title"
        class="min-w-0 rounded-xl border border-border-base bg-surface p-6 shadow-soft sm:p-10 lg:p-12"
      >
        <header class="border-b border-border-base pb-8">
          <div class="flex flex-wrap items-center gap-2">
            <Badge tone="accent">
              <Scale class="size-3" stroke-width={2} aria-hidden="true" />
              Legal
            </Badge>
            <Badge tone="outline">{appName}</Badge>
          </div>

          <h1 id="document-title" class="mt-4 text-3xl font-semibold sm:text-4xl">
            {doc.label}
          </h1>
          <p class="mt-3 max-w-2xl text-base leading-7 text-muted">{appDescription}</p>

          <div class="mt-6 flex flex-wrap items-end justify-between gap-4">
            <DocumentMeta
              effectiveDate={data.effectiveDate}
              updatedDate={data.updatedDate}
              draft={data.draft}
            />
            <button
              type="button"
              onclick="window.print()"
              class="no-print inline-flex items-center gap-2 rounded-md border border-border-base bg-surface px-3 py-2 text-sm font-medium text-muted transition-colors hover:border-border-strong hover:bg-surface-muted hover:text-fg"
            >
              <Printer class="size-4" stroke-width={1.75} aria-hidden="true" />
              Print / save as PDF
            </button>
          </div>
        </header>

        {data.summary && (
          <aside
            aria-label="At a glance"
            class="mt-8 rounded-lg border border-matcha-300/70 bg-mist-100 p-5 text-sm leading-6 text-pine-800 dark:border-matcha-700 dark:bg-accent dark:text-accent-fg sm:p-6"
          >
            <h2 class="flex items-center gap-2 text-xs font-semibold tracking-[0.14em] uppercase">
              <FileText class="size-4" stroke-width={2} aria-hidden="true" />
              At a glance
            </h2>
            <p class="mt-2 text-[0.95rem] leading-7">{data.summary}</p>
          </aside>
        )}

        <div class="prose mt-8">
          <Content />
        </div>

        <ContactCard
          name={data.contact.name}
          repository={data.contact.repository}
          issues={data.contact.issues}
        />
      </article>

      <aside class="min-w-0 xl:sticky xl:top-24 xl:self-start">
        <TableOfContents headings={headings} />

        {otherDocuments.length > 0 && (
          <div class="no-print mt-10 border-t border-border-base pt-6">
            <h2 class="text-xs font-semibold tracking-[0.14em] text-muted uppercase">
              Also for {appName}
            </h2>
            <ul class="mt-4 space-y-2">
              {otherDocuments.map((sibling) => (
                <li>
                  <a
                    href={withBase(sibling.href)}
                    class="inline-flex items-center gap-2 text-sm font-medium"
                  >
                    {sibling.label}
                    <ChevronRight class="size-4" stroke-width={2} aria-hidden="true" />
                  </a>
                </li>
              ))}
              <li>
                <a
                  href={withBase(`/${doc.appId}`)}
                  class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-fg"
                >
                  All {appName} documents
                  <ChevronRight class="size-4" stroke-width={2} aria-hidden="true" />
                </a>
              </li>
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
