---
import { render } from 'astro:content';
import { ChevronRight, FileText, Printer } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DocumentMeta from '@/features/legal/DocumentMeta.astro';
import TableOfContents from '@/features/legal/TableOfContents.astro';
import ContactCard from '@/features/support/ContactCard.astro';
import type { LegalDocument } from '@/lib/legal';
import { absoluteUrl, withBase } from '@/lib/paths';
interface Props {
  document: LegalDocument;
  siblings: LegalDocument[];
  appName: string;
  appDescription: string;
}
const { document: doc, siblings, appName, appDescription } = Astro.props;
const { Content, headings } = await render(doc.entry);
const { data } = doc.entry;
const path = `/${doc.appId}/${doc.documentId}`;
const title = `${appName} ${doc.label}`;
const otherDocuments = siblings.filter((sibling) => sibling.id !== doc.id);
const jsonLd = [
  {
    '@type': 'DigitalDocument',
    name: title,
    description: data.description,
    url: absoluteUrl(path, Astro.site),
    dateModified: data.updatedDate.toISOString(),
    datePublished: data.effectiveDate.toISOString(),
    inLanguage: 'en',
    publisher: { '@type': 'Organization', name: appName },
  },
];
---

<BaseLayout
  title={title}
  description={data.description}
  path={path}
  type="article"
  noindex={data.draft}
  publishedTime={data.effectiveDate}
  modifiedTime={data.updatedDate}
  jsonLd={jsonLd}
>
  <div class="shell legal-shell">
    <nav aria-label="Breadcrumb" class="legal-breadcrumb no-print">
      <ol>
        <li>
          <a href={withBase('/legal/')}>Legal &amp; policies</a>
        </li>
        <li aria-hidden="true">
          <ChevronRight size={16} />
        </li>
        <li>
          <a href={withBase(`/${doc.appId}`)}>{appName}</a>
        </li>
        <li aria-hidden="true">
          <ChevronRight size={16} />
        </li>
        <li aria-current="page">{doc.label}</li>
      </ol>
    </nav>
    <header class="legal-heading">
      <p class="eyebrow">{appName} / LEGAL</p>
      <h1 id="document-title">{doc.label}</h1>
      <p class="legal-description">{appDescription}</p>
      <div class="legal-heading-actions">
        <DocumentMeta
          effectiveDate={data.effectiveDate}
          updatedDate={data.updatedDate}
          draft={data.draft}
        />
        <button type="button" data-print-document class="ds-action ds-action--outline no-print">
          <Printer size={18} stroke-width={1.5} aria-hidden="true" />
          Print / save as PDF
        </button>
      </div>
      <p class="legal-language">Published in English.</p>
    </header>
    <div class="legal-grid">
      <aside class="legal-sidebar no-print">
        <TableOfContents headings={headings} />
        {otherDocuments.length > 0 && (
          <nav class="legal-related" aria-label={`More ${appName} documents`}>
            <h2>Also for {appName}</h2>
            {otherDocuments.map((sibling) => (
              <a href={withBase(sibling.href)}>
                {sibling.label}
                <ChevronRight size={16} aria-hidden="true" />
              </a>
            ))}
            <a href={withBase(`/${doc.appId}`)}>
              All {appName} documents
              <ChevronRight size={16} aria-hidden="true" />
            </a>
          </nav>
        )}
      </aside>
      <article aria-labelledby="document-title" class="legal-document">
        {data.summary && (
          <aside aria-label="At a glance" class="legal-summary">
            <h2>
              <FileText size={18} stroke-width={1.5} aria-hidden="true" />
              At a glance
            </h2>
            <p>{data.summary}</p>
          </aside>
        )}
        <div class="prose legal-prose">
          <Content />
        </div>
        <ContactCard
          name={data.contact.name}
          repository={data.contact.repository}
          issues={data.contact.issues}
        />
      </article>
    </div>
  </div>
</BaseLayout>
<script>
  document.querySelector('[data-print-document]')?.addEventListener('click', () => window.print());
</script>
