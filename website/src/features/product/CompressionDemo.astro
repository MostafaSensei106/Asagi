---
import { content } from './locales';
const { locale } = Astro.props;
const { t, copy } = content(locale);
---

<div class="compression-demo" data-demo>
  <div class="demo-top">
    <span>{t('targetSizeOptimizer')}</span>
    <span class="demo-dot" aria-hidden="true"></span>
  </div>
  <div class="landscape" aria-hidden="true">
    <div class="sun-disc"></div>
    <div class="mountain mountain-back"></div>
    <div class="mountain mountain-front"></div>
    <span class="landscape-frame">KUYMO / 01</span>
  </div>
  <div class="demo-file">
    <span class="file-symbol" aria-hidden="true">
      ↗
    </span>
    <div>
      <strong>moments.mp4</strong>
      <span>{t('originalSize')} · 128 MB</span>
    </div>
    <span class="file-type">MP4</span>
  </div>
  <div class="demo-target">
    <label for="target-size">{t('targetSizeMB')}</label>
    <output for="target-size" data-size-output>
      24 MB
    </output>
  </div>
  <input
    id="target-size"
    type="range"
    min="8"
    max="64"
    value="24"
    step="8"
    aria-valuetext="24 MB"
  />
  <div class="size-bars" aria-hidden="true">
    <span></span>
    <span data-size-bar style="width:18.75%"></span>
  </div>
  <div class="demo-bottom">
    <span>{t('onDeviceProcessingLabel')}</span>
    <span aria-hidden="true">↘</span>
  </div>
  <p class="demo-note">{copy.demo}</p>
</div>
<script>
  const range = document.querySelector<HTMLInputElement>('[data-demo] input');
  range?.addEventListener('input', () => {
    const output = document.querySelector<HTMLOutputElement>('[data-size-output]');
    const bar = document.querySelector<HTMLElement>('[data-size-bar]');
    if (output) output.value = `${range.value} MB`;
    range.setAttribute('aria-valuetext', `${range.value} MB`);
    if (bar) bar.style.width = `${(Number(range.value) / 128) * 100}%`;
  });
</script>
