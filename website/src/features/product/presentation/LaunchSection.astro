---
import BrushMark from '@/components/site/BrushMark.astro';
import StoreAction from '@/components/site/StoreAction.astro';
import ActionLink from '@/components/site/ActionLink.astro';
import StatusBadge from '@/components/site/StatusBadge.astro';
import { withBase } from '@/lib/paths';
import { siteCopy } from '../data/site-copy';
import { content, localePath } from '../locales';
import { launch, product, storeUrl } from '../data/product';
const { locale, full = false } = Astro.props;
const { t } = content(locale);
const site = siteCopy(locale);
const liveUrl = storeUrl(launch);
---

<section class:list={['shell launch-section', { 'launch-section--full': full }]} data-reveal>
  <div>
    <p class="eyebrow">KUYMO / ANDROID 11+</p>
    <h2>{t('brandTagline')}</h2>
    <StatusBadge label={liveUrl ? site.free : site.coming} />
    {full && <p>{liveUrl ? site.localBody : site.playAnswer}</p>}
  </div>
  <div class="launch-actions">
    <StoreAction locale={locale} />
    <ActionLink href={withBase(localePath(locale, 'screenshots'))} variant="text">
      {site.screens}
    </ActionLink>
  </div>
  {full && (
    <a class="inline-link release-follow" href={product.releases}>
      {site.follow} / GitHub
    </a>
  )}
  <BrushMark class="launch-brush" />
</section>
