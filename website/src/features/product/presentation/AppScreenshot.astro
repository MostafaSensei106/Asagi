---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { siteCopy } from '../data/site-copy';
interface Props {
  image: ImageMetadata;
  alt: string;
  locale: string;
  priority?: boolean;
  hero?: boolean;
}
const { image, alt, locale, priority = false, hero = false } = Astro.props;
const copy = siteCopy(locale);
---

<div class:list={['screenshot', { 'screenshot--hero': hero }]} data-screenshot>
  <a
    href={image.src}
    data-gallery-link
    data-image-label={alt}
    aria-label={`${copy.openImage}: ${alt}`}
    class="screenshot-link"
  >
    <Image
      src={image}
      width={image.width}
      widths={[220, 330, image.width]}
      sizes="(max-width: 720px) 65vw, (max-width: 1100px) 28vw, 260px"
      format="webp"
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
    <span class="screenshot-zoom" aria-hidden="true">
      ↗
    </span>
  </a>
  <div class="image-failure" hidden role="status">
    <p>{copy.imageError}</p>
    <button type="button" data-retry-image class="ds-action ds-action--outline">
      {copy.retry}
    </button>
  </div>
</div>
