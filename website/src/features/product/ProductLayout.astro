---
import arabicBold from '../../assets/fonts/vendor/NotoSansArabic-Bold.woff2?url';
import arabicRegular from '../../assets/fonts/vendor/NotoSansArabic-Regular.woff2?url';
import Seo from '@/components/seo/Seo.astro';
import { absoluteUrl } from '@/lib/paths';
import { content, locales, localePath, type Section } from './locales';
import ProductHeader from './presentation/ProductHeader.astro';
import ProductFooter from './presentation/ProductFooter.astro';
import GalleryDialog from './presentation/GalleryDialog.astro';
import '@/styles/global.css';
import './product.css';
interface Props {
  locale: string;
  section: Section;
  title: string;
  description: string;
  noindex?: boolean;
  path?: string;
}
const {
  locale,
  section,
  title,
  description,
  noindex = false,
  path: canonicalOverride,
} = Astro.props;
const { copy, rtl } = content(locale);
---

<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'}>
  <head>
    {locale === 'ar' && (
      <>
        <link rel="preload" href={arabicBold} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={arabicRegular} as="font" type="font/woff2" crossorigin />
      </>
    )}
    <Seo
      title={title}
      description={description}
      path={canonicalOverride ?? (noindex ? '/design-system/' : localePath(locale, section))}
      locale={locale}
      noindex={noindex}
      jsonLd={
        noindex
          ? []
          : [
              {
                '@type': 'SoftwareApplication',
                name: 'Kuymo',
                operatingSystem: 'Android 11+',
                applicationCategory: 'MultimediaApplication',
                description,
                isAccessibleForFree: true,
              },
            ]
      }
    />
    {!noindex && (
      <>
        {locales.map((language) => (
          <link
            rel="alternate"
            hreflang={language}
            href={absoluteUrl(localePath(language, section), Astro.site)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={absoluteUrl(localePath('en', section), Astro.site)}
        />
      </>
    )}
    <script is:inline>
      try {
        const saved = localStorage.getItem('kuymo-theme');
        const dark =
          saved === 'dark' ||
          (saved === null && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      } catch {
        /* The light theme stays usable when storage is blocked. */
      }
    </script>
  </head>
  <body class="product-site">
    <a href="#main-content" class="skip-link">
      {copy.skip}
    </a>
    <ProductHeader locale={locale} section={section} />
    <main id="main-content">
      <slot />
    </main>
    <ProductFooter locale={locale} />
    <GalleryDialog locale={locale} />
    <script>
      import { initTheme } from './scripts/theme';
      import { initGallery } from './scripts/gallery';
      import { initMotion } from '@/design-system/motion';
      initTheme();
      initGallery();
      initMotion();
    </script>
  </body>
</html>
