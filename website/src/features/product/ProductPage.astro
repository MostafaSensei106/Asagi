---
import ContentCollection from './presentation/ContentCollection.astro';
import ProductLayout from './ProductLayout.astro';
import HeroSection from './presentation/HeroSection.astro';
import FeatureGrid from './presentation/FeatureGrid.astro';
import ScreenshotGallery from './presentation/ScreenshotGallery.astro';
import WorkflowSection from './presentation/WorkflowSection.astro';
import FaqSection from './presentation/FaqSection.astro';
import DeveloperSection from './presentation/DeveloperSection.astro';
import LaunchSection from './presentation/LaunchSection.astro';
import FeatureDetail from './presentation/FeatureDetail.astro';
import { content, type Section } from './locales';
import { features } from './data/product';
import { siteCopy } from './data/site-copy';
interface Props {
  locale: string;
  section: Section;
}
const { locale, section } = Astro.props;
const { t, copy } = content(locale);
const site = siteCopy(locale);
const selected = features.find((feature) => feature.route === section);
const title = selected
  ? t(selected.titleKey)
  : (
      {
        '': t('brandTagline'),
        features: copy.features,
        screenshots: site.screens,
        about: site.about,
        developer: site.developer,
        download: site.coming,
      } as Record<string, string>
    )[section]!;
const description = selected
  ? site[selected.body]
  : section === 'developer'
    ? site.developerBody
    : section === 'screenshots'
      ? site.galleryBody
      : section === 'download'
        ? site.playAnswer
        : site.aboutBody;
---

<ProductLayout locale={locale} section={section} title={title} description={description}>
  {section === '' ? (
    <HeroSection locale={locale} />
  ) : (
    <section class="shell page-intro">
      <p class="eyebrow">KUYMO / {section === 'screenshots' ? 'GALLERY' : 'ANDROID'}</p>
      <h1>{title}</h1>
      <p>{description}</p>
    </section>
  )}
  {['', 'about'].includes(section) && <ContentCollection locale={locale} kind="useCases" />}
  {selected ? (
    <FeatureDetail feature={selected} locale={locale} />
  ) : (
    <>
      {['', 'features', 'about'].includes(section) && <FeatureGrid locale={locale} />}
      {['', 'screenshots'].includes(section) && (
        <ScreenshotGallery locale={locale} compact={section !== 'screenshots'} />
      )}
      {['', 'about'].includes(section) && <WorkflowSection locale={locale} />}
      {['', 'about', 'developer'].includes(section) && (
        <DeveloperSection locale={locale} full={section === 'developer'} />
      )}
    </>
  )}
  {['', 'features'].includes(section) && <ContentCollection locale={locale} kind="capabilities" />}
  {['', 'about', 'features/target-size'].includes(section) && (
    <ContentCollection locale={locale} kind="reliability" />
  )}
  {['about', 'features', 'features/on-device'].includes(section) && (
    <ContentCollection locale={locale} kind="formats" />
  )}
  {section !== 'screenshots' && <FaqSection locale={locale} />}
  <LaunchSection locale={locale} full={section === 'download'} />
</ProductLayout>
