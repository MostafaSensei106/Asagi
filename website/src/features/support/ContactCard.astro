---
import { ArrowUpRight, Mail } from '@lucide/astro';
interface Props {
  name: string;
  repository: string;
  issues?: string | undefined;
}
const { name, repository, issues } = Astro.props;
---

<section class="legal-contact no-print" aria-labelledby="contact-heading">
  <Mail size={28} stroke-width={1.5} aria-hidden="true" />
  <div>
    <h2 id="contact-heading">Questions about this document?</h2>
    <p>
      Contact {name} through the project issue tracker. Please avoid posting personal data in a
      public issue.
    </p>
    <div class="legal-contact-links">
      <a class="inline-link" href={issues ?? `${repository}/issues`}>
        Ask about this document on GitHub
        <ArrowUpRight size={18} aria-hidden="true" />
      </a>
      <a class="inline-link" href={repository}>
        View the project repository
        <ArrowUpRight size={18} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
