---
import { ArrowRight, FileText } from '@lucide/astro';

import type { LegalApp } from '@/lib/legal';
import { withBase } from '@/lib/paths';

interface Props {
  app: LegalApp;
}

const { app } = Astro.props;

const newestUpdate = app.documents.reduce<Date | undefined>((latest, document) => {
  const updated = document.entry.data.updatedDate;

  return latest === undefined || updated > latest ? updated : latest;
}, undefined);

const updatedLabel = newestUpdate
  ? new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(newestUpdate)
  : undefined;
---

<article class="legal-card">
  <FileText size={28} stroke-width={1.5} aria-hidden="true" />
  {app.draft && <span class="eyebrow">Draft</span>}
  <h2>
    <a href={withBase(`/${app.appId}`)}>
      {app.name}
      <ArrowRight size={22} aria-hidden="true" />
    </a>
  </h2>
  <p>{app.description}</p>
  <ul>
    {app.documents.map((document) => (
      <li>{document.label}</li>
    ))}
  </ul>
  <p class="legal-card-meta">{updatedLabel ? `Updated ${updatedLabel}` : 'Coming soon'}</p>
</article>
