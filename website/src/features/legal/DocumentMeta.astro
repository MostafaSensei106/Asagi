---
import { CalendarClock, ShieldAlert } from '@lucide/astro';

import Badge from '@/components/ui/Badge.astro';

interface Props {
  effectiveDate: Date;
  updatedDate: Date;
  draft: boolean;
}

const { effectiveDate, updatedDate, draft } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en', {
  dateStyle: 'long',
  timeZone: 'UTC',
});

const formatDate = (date: Date): string => dateFormatter.format(date);
---

<div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
  <span class="inline-flex items-center gap-2">
    <CalendarClock class="size-4" stroke-width={1.75} aria-hidden="true" />
    <span>
      {draft ? 'Prepared' : 'Effective'}{' '}
      <time datetime={effectiveDate.toISOString()}>{formatDate(effectiveDate)}</time>
    </span>
  </span>
  <span class="inline-flex items-center gap-2">
    <span class="size-1.5 rounded-full bg-border-strong" aria-hidden="true"></span>
    <span>
      Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
    </span>
  </span>
</div>

{draft && (
  <div class="mt-5 flex items-start gap-3 rounded-lg border border-apricot bg-apricot/25 p-4 text-sm text-fg">
    <ShieldAlert
      class="mt-0.5 size-5 shrink-0 text-highlight-fg"
      stroke-width={1.75}
      aria-hidden="true"
    />
    <div>
      <Badge tone="highlight" class="mb-2 align-middle">
        Draft
      </Badge>
      <p>
        This document is a placeholder for an upcoming app. It is not in force yet, is excluded from
        search engines and the sitemap, and is not linked from public listings.
      </p>
    </div>
  </div>
)}
