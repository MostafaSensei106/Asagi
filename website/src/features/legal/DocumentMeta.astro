---
import { CalendarClock, ShieldAlert } from '@lucide/astro';
interface Props {
  effectiveDate: Date;
  updatedDate: Date;
  draft: boolean;
}
const { effectiveDate, updatedDate, draft } = Astro.props;
const formatter = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' });
---

<div class="document-meta">
  <span>
    <CalendarClock size={16} stroke-width={1.5} aria-hidden="true" />
    {draft ? 'Prepared' : 'Effective'}{' '}
    <time datetime={effectiveDate.toISOString()}>{formatter.format(effectiveDate)}</time>
  </span>
  <span>
    Updated <time datetime={updatedDate.toISOString()}>{formatter.format(updatedDate)}</time>
  </span>
</div>
{draft && (
  <aside class="legal-draft">
    <ShieldAlert size={22} stroke-width={1.5} aria-hidden="true" />
    <div>
      <strong>Draft — not in force</strong>
      <p>
        This document is a placeholder for an upcoming app. It is not in force yet, is excluded from
        search engines and the sitemap, and is not linked from public listings.
      </p>
    </div>
  </aside>
)}
