---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const items = Astro.props.headings.filter((heading) => heading.depth === 2);
---

{items.length > 0 && (
  <nav aria-labelledby="toc-heading" class="document-toc">
    <h2 id="toc-heading">On this page</h2>
    <ol>
      {items.map((heading, index) => (
        <li>
          <a href={`#${heading.slug}`}>
            <span class="mono" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span>{heading.text.replace(/^\d+[.)]\s*/, '')}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
