---
import { ChevronRight, ShieldAlert } from '@lucide/astro';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import DocumentCard from '@/features/legal/DocumentCard.astro';
import { absoluteUrl, withBase } from '@/lib/paths';
import { getLegalApps, type LegalApp } from '@/lib/legal';

export async function getStaticPaths() {
  const apps = await getLegalApps({ includeDrafts: true });

  return apps.map((app) => ({
    params: { appId: app.appId },
    props: { app },
  }));
}

interface Props {
  app: LegalApp;
}

const { app } = Astro.props;

const path = `/${app.appId}`;
const title = `${app.name} Privacy & Terms`;
const description = `${app.description} Read the ${app.name} privacy policy and terms in full.`;

const publishedDocuments = app.documents.filter((document) => !document.entry.data.draft);

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: title,
    description,
    url: absoluteUrl(path, Astro.site),
    inLanguage: 'en',
    publisher: { '@type': 'Organization', name: app.name },
    hasPart: publishedDocuments.map((document) => ({
      '@type': 'DigitalDocument',
      name: `${app.name} ${document.label}`,
      url: absoluteUrl(document.href, Astro.site),
    })),
  },
];
---

<BaseLayout title={title} description={description} path={path} noindex={app.draft} jsonLd={jsonLd}>
  <section class="border-b border-border-base bg-surface">
    <div class="page-shell py-12 sm:py-16">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
          <li>
            <a href={withBase('/')} class="transition-colors hover:text-fg">
              All apps
            </a>
          </li>
          <li aria-hidden="true">
            <ChevronRight class="size-4 text-border-strong" stroke-width={2} />
          </li>
          <li aria-current="page" class="font-medium text-fg">
            {app.name}
          </li>
        </ol>
      </nav>

      <div class="flex flex-wrap items-center gap-2">
        <Badge tone="accent">{app.name}</Badge>
        {app.draft && <Badge tone="outline">Draft</Badge>}
      </div>

      <h1 class="mt-4 max-w-3xl text-3xl font-semibold sm:text-4xl">
        {app.name} privacy &amp; terms
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-muted">{app.description}</p>
    </div>
  </section>

  <section class="page-shell py-12 sm:py-16" aria-labelledby="documents-heading">
    <h2 id="documents-heading" class="sr-only">
      Documents
    </h2>

    {app.draft && (
      <p class="mb-8 flex items-start gap-3 rounded-lg border border-dashed border-border-strong bg-surface p-5 text-sm leading-6 text-muted">
        <ShieldAlert
          class="mt-0.5 size-5 shrink-0 text-highlight-fg dark:text-highlight"
          stroke-width={1.75}
          aria-hidden="true"
        />
        <span>
          These documents are a draft and are not yet in force. They are published here for preview
          only and are excluded from search engines.
        </span>
      </p>
    )}

    <div class="grid gap-6 sm:grid-cols-2">
      {app.documents.map((document) => (
        <DocumentCard document={document} />
      ))}
    </div>

    {app.documents.length === 0 && (
      <p class="rounded-lg border border-dashed border-border-strong p-8 text-center text-sm text-muted">
        Documents for {app.name} are being prepared. Check back soon.
      </p>
    )}
  </section>
</BaseLayout>
