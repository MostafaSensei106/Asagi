---
import { FileCheck, Lock, Smartphone } from '@lucide/astro';

import BaseLayout from '@/layouts/BaseLayout.astro';
import AppCard from '@/features/home/AppCard.astro';
import { absoluteUrl } from '@/lib/paths';
import { getLegalApps } from '@/lib/legal';
import { siteConfig } from '@/config/site';

const apps = await getLegalApps();
const publishedApps = apps.filter((app) => !app.draft);

const description =
  'Privacy policies and terms for Kuymo and other apps by MostafaSensei106. On-device processing, no accounts, plain language.';

const principles = [
  {
    icon: Smartphone,
    title: 'On-device by default',
    body: 'Compression and analysis run on your phone. Media stays in your control.',
  },
  {
    icon: Lock,
    title: 'No accounts, no trackers',
    body: 'This site sets no cookies and runs no analytics. Nothing to opt out of here.',
  },
  {
    icon: FileCheck,
    title: 'Written to be read',
    body: 'Short sections, a summary at the top, and no walls of legal fog.',
  },
];

const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': `${absoluteUrl('/legal/', Astro.site)}#website`,
    url: absoluteUrl('/legal/', Astro.site),
    name: siteConfig.name,
    description: siteConfig.description,
    inLanguage: siteConfig.locale,
    publisher: { '@type': 'Organization', name: siteConfig.author.name },
  },
  {
    '@type': 'CollectionPage',
    name: 'Kuymo · Legal & policies',
    description,
    url: absoluteUrl('/legal/', Astro.site),
    hasPart: publishedApps.map((app) => ({
      '@type': 'WebPage',
      name: `${app.name} legal documents`,
      url: absoluteUrl(`/${app.appId}`, Astro.site),
    })),
  },
];
---

<BaseLayout
  title="Kuymo · Legal & policies"
  description={description}
  path="/legal/"
  jsonLd={jsonLd}
>
  <div class="shell legal-shell">
    <header class="legal-heading">
      <p class="eyebrow">Legal &amp; policies</p>
      <h1>Understand what happens to your data.</h1>
      <p class="legal-description">
        Every document here describes real behaviour: what stays on your device, what leaves it, and
        why. Read the full policies below.
      </p>
      <a class="inline-link" href={siteConfig.repository}>
        View the project source
      </a>
    </header>
    <section aria-labelledby="apps-heading">
      <h2 id="apps-heading">Apps &amp; policies</h2>
      <div class="legal-cards">
        {publishedApps.map((app) => (
          <AppCard app={app} />
        ))}
      </div>
      {publishedApps.length === 0 && <p>Legal documents are being prepared. Check back soon.</p>}
    </section>
    <section class="legal-principles" aria-labelledby="principles-heading">
      <h2 id="principles-heading">How these apps handle data</h2>
      <div class="legal-cards">
        {principles.map((principle) => (
          <article class="legal-card">
            <principle.icon size={28} stroke-width={1.5} aria-hidden="true" />
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
