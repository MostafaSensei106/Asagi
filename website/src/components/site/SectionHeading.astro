---
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  id?: string;
}
const { title, eyebrow, description, id } = Astro.props;
---

<div class="section-heading" data-slot="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
  </div>
  {description && <p>{description}</p>}
  <slot />
</div>
